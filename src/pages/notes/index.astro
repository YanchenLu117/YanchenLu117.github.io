---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Bilingual from '../../components/Bilingual.astro';
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';
import { ui } from '../../data/i18n';
import { withBase } from '../../utils/base';
import { noteSlug } from '../../utils/notes';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date, locale: string) =>
  new Intl.DateTimeFormat(locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);

const noteCount = {
  en: `${notes.length} ${notes.length === 1 ? 'entry' : 'entries'}`,
  zh: `${notes.length} 篇`,
};
---

<Layout
  title={`Notes — ${profile.name}`}
  description={`Technical notes and essays by ${profile.name}.`}
>
  <Header />

  <main id="main" class="container-page flex-1 pb-16">
    <section aria-labelledby="notes-title" class="note-index pt-12 sm:pt-16">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <div>
          <p class="eyebrow"><Bilingual value={ui.notes.writing} /></p>
          <h1
            id="notes-title"
            class="mt-2 font-serif text-[38px] font-medium leading-none tracking-[-0.02em] text-ink sm:text-[46px]"
          >
            <Bilingual value={ui.notes.title} />
          </h1>
        </div>
        <p class="pb-1 font-mono text-[10.5px] text-muted">
          <Bilingual value={noteCount} />
        </p>
      </div>

      <div class="section-rule"></div>

      <p class="mt-5 max-w-[620px] font-serif text-[15.5px] leading-7 text-muted">
        <Bilingual value={ui.notes.intro} />
      </p>

      <ul class="note-list mt-7">
        {
          notes.map((note) => {
            const slug = noteSlug(note.id);
            return (
              <li>
                <a
                  href={withBase(`/notes/${slug}/`)}
                  class="group grid gap-2 py-6 sm:grid-cols-[112px_minmax(0,1fr)] sm:gap-8"
                >
                  <time
                    datetime={note.data.date.toISOString()}
                    class="pt-1 font-mono text-[10.5px] tabular-nums text-muted"
                  >
                    <span class="lang-en" lang="en">{formatDate(note.data.date, 'en-US')}</span>
                    <span class="lang-zh" lang="zh-CN">{formatDate(note.data.date, 'zh-CN')}</span>
                  </time>
                  <div>
                    <h2 class="font-serif text-[23px] font-medium leading-snug tracking-[-0.01em] text-ink transition-colors group-hover:text-accent">
                      {note.data.title}
                    </h2>
                    <p class="mt-1.5 text-[13.5px] leading-6 text-muted">
                      {note.data.description}
                    </p>
                    <div class="mt-3 flex flex-wrap items-baseline gap-x-4 gap-y-1">
                      {note.data.tags.map((tag) => (
                        <span class="eyebrow">{tag}</span>
                      ))}
                      <span class="stage-marker" data-stage={note.data.stage}>
                        {note.data.stage}
                      </span>
                    </div>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>

      {
        notes.length === 0 && (
          <p class="mt-8 border-t border-hairline pt-5 font-serif text-[15px] italic text-muted">
            <Bilingual value={ui.notes.comingSoon} />
          </p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>
