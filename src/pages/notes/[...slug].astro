---
import 'katex/dist/katex.min.css';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Bilingual from '../../components/Bilingual.astro';
import Sidenote from '../../components/Sidenote.astro';
import { profile } from '../../data/profile';
import { ui } from '../../data/i18n';
import { withBase } from '../../utils/base';
import { noteSlug } from '../../utils/notes';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: noteSlug(note.id) },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);

const published = note.data.date;
const publishedIso = published.toISOString();
const publishedLabelEn = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(published);
const publishedLabelZh = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(published);
---

<Layout
  title={`${note.data.title} — ${profile.name}`}
  description={note.data.description}
  pageType="article"
  academicMeta={false}
  publishedTime={publishedIso}
>
  <Header />

  <main id="main" class="container-page flex-1 pb-16">
    <article class="note-article mx-auto max-w-[832px] pt-12 sm:pt-16">
      <a
        href={withBase('/notes/')}
        class="no-print editorial-link inline-flex items-center gap-1 text-[12px]"
      >
        ← <Bilingual value={ui.notes.allNotes} />
      </a>

      <header class="mt-6">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[10.5px] text-muted">
          <time datetime={publishedIso}>
            <span class="lang-en" lang="en">{publishedLabelEn}</span>
            <span class="lang-zh" lang="zh-CN">{publishedLabelZh}</span>
          </time>
          {note.data.tags.map((tag) => <span class="eyebrow">{tag}</span>)}
          <span class="stage-marker" data-stage={note.data.stage}>{note.data.stage}</span>
        </div>
        <h1
          class="mt-3 font-serif text-[36px] font-medium leading-[1.12] tracking-[-0.02em] text-ink sm:text-[46px]"
        >
          {note.data.title}
        </h1>
        <p class="mt-3 font-serif text-[16px] italic leading-7 text-muted">
          {note.data.description}
        </p>
      </header>

      <div class="section-rule"></div>

      <div class="note-prose mt-8">
        <Content components={{ Sidenote }} />
      </div>

      <div class="no-print mt-12 border-t border-hairline pt-5">
        <a
          href={withBase('/notes/')}
          class="editorial-link inline-flex items-center gap-1 text-[12px]"
        >
          ← <Bilingual value={ui.notes.backAllNotes} />
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
