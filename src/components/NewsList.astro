---
import { news } from '../data/news';
import { ui } from '../data/i18n';
import Bilingual from './Bilingual.astro';

interface Props {
  id?: string;
  class?: string;
}

const { id = 'news', class: className = '' } = Astro.props;
const titleId = `${id}-title`;
---

<section id={id} aria-labelledby={titleId} class={`scroll-mt-24 ${className}`}>
  <div class="flex items-end justify-between gap-4">
    <h2 id={titleId} class="section-title"><Bilingual value={ui.sections.news} /></h2>
    <span class="eyebrow pb-1"><Bilingual value={ui.sections.recentUpdates} /></span>
  </div>
  <div class="section-rule"></div>

  <ul class="news-list mt-3">
    {
      news.map((item) => (
        <li class="grid grid-cols-[56px_1fr] gap-3 py-2.5 sm:grid-cols-[78px_1fr] sm:gap-4">
          <span class="pt-0.5 font-mono text-[10.5px] tabular-nums tracking-tight text-muted">
            {item.date}
          </span>
          <p class="text-[14px] leading-6 text-muted">
            <span class="lang-en" lang="en" set:html={item.content.en} />
            <span class="lang-zh" lang="zh-CN" set:html={item.content.zh} />
          </p>
        </li>
      ))
    }
  </ul>
</section>
