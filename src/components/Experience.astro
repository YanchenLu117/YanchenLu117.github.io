---
import { profile } from '../data/profile';
import { ui } from '../data/i18n';
import { isExternal } from '../utils/base';
import Bilingual from './Bilingual.astro';

const groups = [
  {
    title: ui.sections.education,
    items: profile.experience.filter((item) => item.kind === 'education'),
  },
  {
    title: ui.sections.researchIndustry,
    items: profile.experience.filter((item) => item.kind === 'experience'),
  },
].filter((group) => group.items.length > 0);
---

<section id="experience" aria-labelledby="experience-title" class="scroll-mt-24">
  <h2 id="experience-title" class="section-title">
    <Bilingual value={ui.sections.experience} />
  </h2>
  <div class="section-rule"></div>

  <div class="mt-6 space-y-8">
    {
      groups.map((group) => (
        <div class="grid gap-3 sm:grid-cols-[112px_minmax(0,1fr)] sm:gap-8">
          <h3 class="eyebrow pt-1">
            <Bilingual value={group.title} />
          </h3>
          <ul class="space-y-5">
            {group.items.map((item) => {
              const externalLink = item.organizationUrl
                ? isExternal(item.organizationUrl)
                : false;
              return (
                <li class="grid grid-cols-[28px_minmax(0,1fr)] gap-3 sm:gap-4">
                  <span class="exp-monogram pt-0.5 text-[10px]" aria-hidden="true">
                    {item.monogram}
                  </span>
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                      <p class="font-serif text-[16px] font-medium leading-snug text-ink">
                        <Bilingual value={item.role} />
                      </p>
                      <span class="font-mono text-[10px] tabular-nums text-muted">
                        <Bilingual value={item.period} />
                      </span>
                    </div>
                    <p class="mt-0.5 text-[12.5px] text-muted">
                      {item.organizationUrl ? (
                        <a
                          href={item.organizationUrl}
                          target={externalLink ? '_blank' : undefined}
                          rel={externalLink ? 'noopener noreferrer' : undefined}
                          class="transition-colors hover:text-accent"
                        >
                          <Bilingual value={item.organization} />
                        </a>
                      ) : (
                        <Bilingual value={item.organization} />
                      )}
                    </p>
                    {item.detail && (
                      <p class="mt-1 text-[12px] leading-6 text-muted">
                        <Bilingual value={item.detail} />
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>
