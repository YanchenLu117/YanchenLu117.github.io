---
import { profile } from '../data/profile';
import { ui } from '../data/i18n';
import { isExternal } from '../utils/base';
import Bilingual from './Bilingual.astro';

const groups = [
  {
    title: ui.sections.education,
    items: profile.experience.filter((item) => item.kind === 'education'),
  },
  {
    title: ui.sections.researchIndustry,
    items: profile.experience.filter((item) => item.kind === 'experience'),
  },
].filter((group) => group.items.length > 0);
---

<section id="experience" aria-labelledby="experience-title" class="scroll-mt-24">
  <h2 id="experience-title" class="section-title">
    <Bilingual value={ui.sections.experience} />
  </h2>
  <div class="section-rule"></div>

  <div class="mt-5 space-y-7">
    {
      groups.map((group) => (
        <div>
          <h3 class="text-[10.5px] font-semibold uppercase tracking-[0.13em] text-slate-400 dark:text-slate-500">
            <Bilingual value={group.title} />
          </h3>
          <ul class="mt-3 space-y-4">
            {group.items.map((item) => {
              const externalLink = item.organizationUrl
                ? isExternal(item.organizationUrl)
                : false;
              return (
                <li class="flex gap-3.5">
                  <div
                    class="exp-monogram mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 font-serif text-[11px] font-semibold tracking-wide text-slate-500 dark:border-slate-800 dark:bg-white/[0.03] dark:text-slate-400"
                    aria-hidden="true"
                  >
                    {item.monogram}
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                      <p class="text-[14px] font-semibold text-slate-800 dark:text-slate-200">
                        <Bilingual value={item.role} />
                      </p>
                      <span class="font-mono text-[10.5px] tabular-nums text-slate-400 dark:text-slate-500">
                        <Bilingual value={item.period} />
                      </span>
                    </div>
                    <p class="text-[13px] text-slate-500 dark:text-slate-400">
                      {item.organizationUrl ? (
                        <a
                          href={item.organizationUrl}
                          target={externalLink ? '_blank' : undefined}
                          rel={externalLink ? 'noopener noreferrer' : undefined}
                          class="transition-colors hover:text-blue-700 dark:hover:text-blue-300"
                        >
                          <Bilingual value={item.organization} />
                        </a>
                      ) : (
                        <Bilingual value={item.organization} />
                      )}
                    </p>
                    {item.detail && (
                      <p class="mt-0.5 text-[12.5px] leading-6 text-slate-500 dark:text-slate-500">
                        <Bilingual value={item.detail} />
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>
