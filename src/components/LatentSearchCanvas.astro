---
---

<div class="hero-avatar hidden sm:flex sm:justify-end sm:pt-2">
  <canvas
    id="latent-search-canvas"
    width="280"
    height="280"
    class="block h-[150px] w-[150px]"
    aria-hidden="true"
  ></canvas>
</div>

<script>
  const canvas = document.getElementById('latent-search-canvas') as HTMLCanvasElement | null;
  const context = canvas?.getContext('2d');

  if (canvas && context) {
    const x = context;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0;
    let ink = '';
    let accent = '';
    let pointerX = 0;
    let pointerY = 0;
    let tiltX = 0;
    let tiltY = 0;
    let started = performance.now();

    const colors = () => {
      const s = getComputedStyle(document.documentElement);
      ink = s.getPropertyValue('--ink').trim() || ink;
      accent = s.getPropertyValue('--accent').trim() || accent;
    };

    const smooth = (a: number, b: number, value: number) => {
      const t = Math.min(1, Math.max(0, (value - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };

    /** Project a point on a softly warped latent sheet into the square viewport. */
    const project = (u: number, v: number, rotation: number) => {
      const warp = 0.16 * (u * u - 0.35) + 0.06 * Math.sin(2.4 * v + rotation * 0.8);
      const ry = rotation + tiltX * 0.16;
      const rx = -0.58 + tiltY * 0.12;
      const X = u;
      const Y = v + warp;
      const Z = 0.24 * Math.sin(1.5 * u + rotation * 0.35) + 0.1 * v;
      const cy = Math.cos(ry);
      const sy = Math.sin(ry);
      const X1 = X * cy - Z * sy;
      const Z1 = X * sy + Z * cy;
      const cx = Math.cos(rx);
      const sx = Math.sin(rx);
      const Y1 = Y * cx - Z1 * sx;
      const Z2 = Y * sx + Z1 * cx;
      const perspective = 1 / (1 + Z2 * 0.5);
      const R = W * 0.5;
      return [W / 2 + X1 * R * perspective, W / 2 + Y1 * R * perspective] as const;
    };

    type Branch = {
      p0: readonly [number, number];
      p1: readonly [number, number];
      p2: readonly [number, number];
      delay: number;
      span: number;
      main?: boolean;
    };

    const root: readonly [number, number] = [-0.64, 0.5];
    const nodeA: readonly [number, number] = [-0.3, 0.32];
    const nodeB: readonly [number, number] = [0.12, 0.02];
    const nodeC: readonly [number, number] = [0.38, -0.2];

    const branches: Branch[] = [
      { p0: root, p1: [-0.52, 0.14], p2: [-0.8, -0.02], delay: 0.1, span: 0.34 },
      { p0: root, p1: [-0.2, 0.76], p2: [-0.02, 0.94], delay: 0.18, span: 0.32 },
      { p0: nodeA, p1: [0.02, 0.48], p2: [0.3, 0.58], delay: 0.28, span: 0.32 },
      { p0: nodeA, p1: [0.02, 0.16], p2: [0.2, -0.24], delay: 0.36, span: 0.3 },
      { p0: nodeB, p1: [0.46, 0.24], p2: [0.72, 0.12], delay: 0.4, span: 0.32 },
      { p0: nodeB, p1: [0.42, -0.34], p2: [0.58, -0.64], delay: 0.44, span: 0.3 },
      { p0: nodeB, p1: [0.72, 0.02], p2: [0.92, -0.12], delay: 0.48, span: 0.28 },
      { p0: nodeC, p1: [0.62, -0.34], p2: [0.84, -0.48], delay: 0.52, span: 0.26 },
      { p0: nodeC, p1: [0.58, -0.06], p2: [0.82, 0.06], delay: 0.56, span: 0.24 },
      {
        p0: root,
        p1: [-0.05, 0.18],
        p2: [0.62, -0.5],
        delay: 0,
        span: 0.68,
        main: true,
      },
    ];

    const drawGrid = (rotation: number) => {
      x.strokeStyle = ink;
      x.lineWidth = 0.5;

      for (let line = -3; line <= 3; line += 1) {
        x.globalAlpha = line === 0 ? 0.17 : 0.1;

        x.beginPath();
        for (let step = 0; step <= 26; step += 1) {
          const u = -1 + (2 * step) / 26;
          const [px, py] = project(u, line / 3.3, rotation);
          step ? x.lineTo(px, py) : x.moveTo(px, py);
        }
        x.stroke();

        x.beginPath();
        for (let step = 0; step <= 26; step += 1) {
          const v = -1 + (2 * step) / 26;
          const [px, py] = project(line / 3.3, v, rotation);
          step ? x.lineTo(px, py) : x.moveTo(px, py);
        }
        x.stroke();
      }
    };

    const drawPath = (branch: Branch, progress: number, rotation: number, alpha: number) => {
      if (progress <= 0) return;

      x.beginPath();
      const steps = Math.max(2, Math.round(34 * progress));
      for (let step = 0; step <= steps; step += 1) {
        const t = (step / steps) * progress;
        const m = 1 - t;
        const u = m * m * branch.p0[0] + 2 * m * t * branch.p1[0] + t * t * branch.p2[0];
        const v = m * m * branch.p0[1] + 2 * m * t * branch.p1[1] + t * t * branch.p2[1];
        const [px, py] = project(u, v, rotation);
        step ? x.lineTo(px, py) : x.moveTo(px, py);
      }

      x.strokeStyle = branch.main ? accent : ink;
      x.globalAlpha = alpha;
      x.lineWidth = branch.main ? 1.15 : 0.7;
      x.stroke();
    };

    const draw = (now: number) => {
      if (!W) return;

      const time = still ? 8 : (now - started) / 1000;
      const rotation = still ? 0.5 : time * 0.055;
      const cycle = still ? 0.7 : (time % 9) / 9;
      const overall = 1 - smooth(0.93, 1, cycle);

      x.clearRect(0, 0, W, W);
      drawGrid(rotation);

      for (const branch of branches) {
        if (branch.main) continue;

        const progress = Math.min(1, Math.max(0, (cycle - branch.delay) / branch.span));
        const envelope = smooth(0, 0.12, progress) * (1 - smooth(0.76, 1, progress));
        const alpha = 0.42 * envelope * overall;
        drawPath(branch, progress, rotation, alpha);

        if (progress > 0.92) {
          const [ex, ey] = project(branch.p2[0], branch.p2[1], rotation);
          x.globalAlpha = 0.42 * envelope * overall;
          x.fillStyle = ink;
          x.beginPath();
          x.arc(ex, ey, 1.1, 0, Math.PI * 2);
          x.fill();
        }
      }

      const [rootX, rootY] = project(root[0], root[1], rotation);
      x.globalAlpha = 0.36 * overall;
      x.fillStyle = ink;
      x.beginPath();
      x.arc(rootX, rootY, 1.3, 0, Math.PI * 2);
      x.fill();

      const main = branches[branches.length - 1];
      const mainProgress = Math.min(1, Math.max(0, cycle / main.span));
      drawPath(main, mainProgress, rotation, 0.9 * smooth(0, 0.1, mainProgress) * overall);

      if (mainProgress > 0.95) {
        const [ex, ey] = project(main.p2[0], main.p2[1], rotation);
        const pulse = 0.5 + 0.5 * Math.sin(time * 2.1);

        x.strokeStyle = accent;
        x.lineWidth = 0.6;
        x.globalAlpha = (0.2 + 0.2 * pulse) * overall;
        x.beginPath();
        x.arc(ex, ey, 3.2 + pulse * 1.1, 0, Math.PI * 2);
        x.stroke();

        x.fillStyle = accent;
        x.globalAlpha = 0.9 * overall;
        x.beginPath();
        x.arc(ex, ey, 1.7, 0, Math.PI * 2);
        x.fill();
      }

      x.globalAlpha = 1;
    };

    const size = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const box = canvas.getBoundingClientRect();
      W = Math.max(1, Math.round(box.width || 140));
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(W * dpr);
      x.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (still) draw(performance.now());
    };

    canvas.onpointermove = (event) => {
      const box = canvas.getBoundingClientRect();
      pointerX = ((event.clientX - box.left) / box.width - 0.5) * 2;
      pointerY = ((event.clientY - box.top) / box.height - 0.5) * 2;
      if (still) draw(performance.now());
    };

    canvas.onpointerleave = () => {
      pointerX = 0;
      pointerY = 0;
      if (still) draw(performance.now());
    };

    const animateTilt = () => {
      tiltX += (pointerX - tiltX) * 0.06;
      tiltY += (pointerY - tiltY) * 0.06;
    };

    const loop = (now: number) => {
      animateTilt();
      draw(now);
      if (!still) requestAnimationFrame(loop);
    };

    new MutationObserver(() => {
      colors();
      if (still) draw(performance.now());
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    colors();
    size();
    addEventListener('resize', size);

    if (!still) {
      started = performance.now() - 4050;
      requestAnimationFrame(loop);
    }
  }
</script>
