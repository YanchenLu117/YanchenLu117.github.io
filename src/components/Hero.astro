---
import { profile } from '../data/profile';
import { ui } from '../data/i18n';
import { isExternal, withBase } from '../utils/base';
import Icon from './Icon.astro';
import Bilingual from './Bilingual.astro';
import LatentSearchCanvas from './LatentSearchCanvas.astro';
---

<section id="about" aria-labelledby="about-title" class="scroll-mt-24 pt-12 sm:pt-16">
  <div
    class="grid grid-cols-1 gap-8 sm:grid-cols-[minmax(0,1fr)_150px] sm:items-start sm:gap-10"
  >
    <div class="min-w-0">
      <h1
        id="about-title"
        class="font-serif text-[36px] font-medium leading-[1.05] tracking-[-0.02em] text-ink sm:text-[48px]"
      >
        <span class="lang-en" lang="en">{profile.name}</span><span class="lang-zh" lang="zh-CN">{profile.nameZh}</span>
        <span
          class="ml-2 align-baseline font-sans text-[10px] font-normal uppercase tracking-[0.14em] text-muted lang-en"
          lang="en"
        >{profile.nameZh}</span>
        <span
          class="ml-2 align-baseline font-sans text-[10px] font-normal uppercase tracking-[0.14em] text-muted lang-zh"
          lang="zh-CN"
        >{profile.name}</span>
      </h1>

      <p class="hero-subtitle mt-3 font-serif text-[15px] italic text-muted">
        <Bilingual value={profile.subtitle} />
      </p>

      <p class="print-only mt-2 font-mono text-[9.5px] leading-5 text-muted">
        <span class="lang-en" lang="en"><span class="font-semibold">{profile.email}</span> · <span class="font-semibold">{profile.phone}</span><br />{profile.location.en} · {profile.affiliation.en}</span>
        <span class="lang-zh" lang="zh-CN"><span class="font-semibold">{profile.email}</span> · <span class="font-semibold">{profile.phone}</span><br />{profile.location.zh} · {profile.affiliation.zh}</span>
      </p>

      <div class="mt-5 space-y-4 font-serif text-[16.5px] leading-[1.8] text-ink">
        {
          profile.bio.map((paragraph) => (
            <p>
              <span class="lang-en" lang="en" set:html={paragraph.en} />
              <span class="lang-zh" lang="zh-CN" set:html={paragraph.zh} />
            </p>
          ))
        }
      </div>

      <div class="mt-6 flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <span class="eyebrow mr-1">
          <Bilingual value={ui.sections.research} />
        </span>
        {
          profile.researchInterests.map((interest, index) => (
            <>
              {index > 0 && (
                <span class="font-serif text-[13px] not-italic text-muted" aria-hidden="true">
                  /
                </span>
              )}
              <span class="research-term font-serif text-[14px] italic text-ink">
                <Bilingual value={interest} />
              </span>
            </>
          ))
        }
      </div>

      <div class="hero-links mt-6 flex flex-wrap items-baseline gap-x-4 gap-y-2">
        {
          profile.links.map((link) => {
            if (link.icon === 'mail' && link.value) {
              return (
                <div class="relative inline-flex items-baseline gap-2">
                  <a
                    href={link.href}
                    class="editorial-link inline-flex items-center gap-1.5 font-mono text-[12px] tabular-nums tracking-[-0.01em]"
                    aria-label={`Email / 邮箱: ${link.value}`}
                  >
                    <Icon name="mail" size={13} class="text-muted" />
                    <span>{link.value}</span>
                  </a>
                  <button
                    type="button"
                    class="copy-button inline-flex h-5 w-5 items-center justify-center"
                    data-copy-email={link.value}
                    aria-label="Copy email address / 复制邮箱地址"
                    title="Copy email address / 复制邮箱地址"
                  >
                    <Icon name="copy" size={12} class="copy-icon" />
                    <Icon name="check" size={12} class="copy-check hidden" />
                  </button>
                  <span
                    class="contact-copy-feedback"
                    data-copy-feedback
                    data-visible="false"
                    role="status"
                    aria-live="polite"
                    aria-atomic="true"
                  >
                    <span class="lang-en" lang="en">Copied</span>
                    <span class="lang-zh" lang="zh-CN">已复制</span>
                  </span>
                </div>
              );
            }

            if (link.icon === 'phone' && link.value) {
              return (
                <a
                  href={link.href}
                  class="editorial-link inline-flex items-center gap-1.5 font-mono text-[12px] tabular-nums tracking-[-0.01em]"
                  aria-label={`Phone / 电话: ${link.value}`}
                >
                  <Icon name="phone" size={13} class="text-muted" />
                  <span>{link.value}</span>
                </a>
              );
            }

            const externalLink = isExternal(link.href);
            return (
              <a
                href={externalLink ? link.href : withBase(link.href)}
                target={externalLink ? '_blank' : undefined}
                rel={externalLink ? 'noopener noreferrer' : undefined}
                class="editorial-link inline-flex items-center gap-1.5 text-[12.5px] font-medium"
              >
                <Icon name={link.icon} size={13} />
                <Bilingual value={link.label} />
              </a>
            );
          })
        }
        <button
          type="button"
          data-print-cv
          class="no-print editorial-link inline-flex items-center gap-1.5 font-mono text-[11px] tracking-[-0.01em] sm:ml-auto"
          title="Print or save as PDF / 打印或导出 PDF"
        >
          <Icon name="pdf" size={12} class="text-muted" />
          <Bilingual value={ui.actions.printCv} />
        </button>
      </div>
    </div>

    <LatentSearchCanvas />
  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const feedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
  const copyIcon = copyButton?.querySelector<SVGElement>('.copy-icon');
  const checkIcon = copyButton?.querySelector<SVGElement>('.copy-check');
  const printButton = document.querySelector<HTMLButtonElement>('[data-print-cv]');
  let resetTimer: number | undefined;

  function fallbackCopy(text: string): boolean {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.focus();
    textarea.select();

    try {
      return document.execCommand('copy');
    } catch {
      return false;
    } finally {
      textarea.remove();
    }
  }

  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.copyEmail ?? '';
    if (!email) return;

    let copied = true;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(email);
      } else {
        copied = fallbackCopy(email);
      }
    } catch {
      copied = fallbackCopy(email);
    }

    if (!copied) return;

    copyIcon?.classList.add('hidden');
    checkIcon?.classList.remove('hidden');
    feedback?.setAttribute('data-visible', 'true');

    window.clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      copyIcon?.classList.remove('hidden');
      checkIcon?.classList.add('hidden');
      feedback?.setAttribute('data-visible', 'false');
    }, 1600);
  });

  printButton?.addEventListener('click', () => window.print());
</script>
