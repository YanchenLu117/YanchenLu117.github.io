---
---

<div class="hero-avatar order-1 sm:order-2 sm:justify-self-end">
  <canvas
    id="manifold-canvas"
    width="360"
    height="360"
    class="mx-auto block h-[136px] w-[136px] sm:mx-0 sm:h-[180px] sm:w-[180px]"
    aria-hidden="true"
  ></canvas>
</div>

<script>
  const c = document.getElementById('manifold-canvas') as HTMLCanvasElement | null;
  const x = c?.getContext('2d');
  if (c && x) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, R = 0, ink = '', acc = '', tx = 0, ty = 0, dx = 0, dy = 0, t0 = performance.now();
    const colors = () => { const s = getComputedStyle(document.documentElement); ink = s.getPropertyValue('--ink').trim() || ink; acc = s.getPropertyValue('--accent').trim() || acc; };
    const proj = (a: number, b: number, d: number, ry: number, rx: number) => {
      const cy = Math.cos(ry), sy = Math.sin(ry), cx = Math.cos(rx), sx = Math.sin(rx);
      const X = a * cy + d * sy, Z = -a * sy + d * cy, Y = b * cx - Z * sx, Z2 = b * sx + Z * cx, p = 1 / (1 + Z2 * 0.16);
      return [W / 2 + X * R * p, W / 2 + Y * R * p];
    };
    const ring = (f: (a: number) => [number, number, number], ry: number, rx: number, alpha: number) => {
      x.beginPath();
      for (let i = 0; i <= 64; i++) { const [a, b, d] = f((i / 64) * Math.PI * 2), [px, py] = proj(a, b, d, ry, rx); i ? x.lineTo(px, py) : x.moveTo(px, py); }
      x.strokeStyle = ink; x.globalAlpha = alpha; x.lineWidth = 0.75; x.stroke();
    };
    const draw = (now: number) => {
      if (!W) return;
      const t = still ? 0.8 : (now - t0) * 0.00016;
      tx += (dx - tx) * 0.05; ty += (dy - ty) * 0.05;
      const ry = t + tx * 0.8, rx = -0.32 + ty * 0.5;
      x.clearRect(0, 0, W, W);
      for (let i = -2; i <= 2; i++) { const a = (i * Math.PI) / 7; ring((v) => [Math.cos(v) * Math.cos(a), Math.sin(a), Math.sin(v) * Math.cos(a)], ry, rx, i ? 0.24 : 0.44); }
      for (let i = 0; i < 6; i++) { const a = (i * Math.PI) / 6; ring((v) => [Math.cos(v) * Math.cos(a), Math.sin(v), Math.cos(v) * Math.sin(a)], ry, rx, 0.2); }
      const phi = 1.1;
      x.beginPath();
      for (let i = 0; i <= 48; i++) { const a = (i / 48) * Math.PI * 2, [px, py] = proj(Math.sin(phi) * Math.cos(a), Math.cos(phi), Math.sin(phi) * Math.sin(a), ry, rx); i ? x.lineTo(px, py) : x.moveTo(px, py); }
      x.strokeStyle = acc; x.globalAlpha = 0.22; x.lineWidth = 0.5; x.stroke();
      const [ox, oy] = proj(0, 0, 0, ry, rx);
      const [ex, ey] = proj(Math.sin(phi) * Math.cos(t * 1.4), Math.cos(phi), Math.sin(phi) * Math.sin(t * 1.4), ry, rx);
      x.globalAlpha = 0.9; x.strokeStyle = acc; x.lineWidth = 1;
      x.beginPath(); x.moveTo(ox, oy); x.lineTo(ex, ey); x.stroke();
      x.fillStyle = acc; x.beginPath(); x.arc(ex, ey, 1.6, 0, Math.PI * 2); x.fill();
      x.globalAlpha = 1;
      if (!still) requestAnimationFrame(draw);
    };
    const size = () => {
      const d = Math.min(devicePixelRatio || 1, 2), b = c.getBoundingClientRect();
      W = Math.max(1, Math.round(b.width)); c.width = Math.round(W * d); c.height = Math.round(W * d);
      x.setTransform(d, 0, 0, d, 0, 0); R = W * 0.4;
      if (still) draw(performance.now());
    };
    c.onpointermove = (e) => { const b = c.getBoundingClientRect(); dx = ((e.clientX - b.left) / b.width - 0.5) * 2; dy = ((e.clientY - b.top) / b.height - 0.5) * 2; if (still) draw(performance.now()); };
    c.onpointerleave = () => { dx = dy = 0; if (still) draw(performance.now()); };
    new MutationObserver(() => { colors(); if (still) draw(performance.now()); }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    colors(); size(); addEventListener('resize', size); if (!still) { t0 = performance.now(); requestAnimationFrame(draw); }
  }
</script>
