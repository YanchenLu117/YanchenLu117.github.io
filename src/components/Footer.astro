---
import { profile } from '../data/profile';

const now = new Date();
const buildMonthEn = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
}).format(now);
const buildMonthZh = new Intl.DateTimeFormat('zh-CN', {
  month: 'long',
  year: 'numeric',
}).format(now);
const year = now.getFullYear();
---

<footer class="site-footer">
  <div
    class="container-page flex flex-col items-center justify-between gap-1.5 py-7 text-[10.5px] text-muted sm:flex-row"
  >
    <p>© {year} {profile.name} · {profile.nameZh}</p>
    <p>
      <span class="lang-en" lang="en">
        Last updated {buildMonthEn}
        <span class="mx-1.5 text-hairline">·</span>
        Built with{' '}
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-link"
        >Astro</a>{' '}
        &amp;{' '}
        <a
          href="https://tailwindcss.com"
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-link"
        >Tailwind CSS</a>
      </span>
      <span class="lang-zh" lang="zh-CN">
        最后更新于 {buildMonthZh}
        <span class="mx-1.5 text-hairline">·</span>
        使用{' '}
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-link"
        >Astro</a>{' '}
        与{' '}
        <a
          href="https://tailwindcss.com"
          target="_blank"
          rel="noopener noreferrer"
          class="editorial-link"
        >Tailwind CSS</a>{' '}
        构建
      </span>
    </p>
  </div>
</footer>
