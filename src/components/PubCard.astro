---
import type { Publication } from '../data/publications';
import { profile } from '../data/profile';
import { isExternal, withBase } from '../utils/base';
import Icon from './Icon.astro';

interface Props {
  publication: Publication;
}

const { publication: pub } = Astro.props;

type LinkItem = {
  label: string;
  href: string;
  icon: 'pdf' | 'code' | 'globe' | 'play';
};

const linkItems: LinkItem[] = [];
if (pub.links?.pdf) linkItems.push({ label: 'PDF', href: pub.links.pdf, icon: 'pdf' });
if (pub.links?.code) linkItems.push({ label: 'Code', href: pub.links.code, icon: 'code' });
if (pub.links?.project) linkItems.push({ label: 'Project', href: pub.links.project, icon: 'globe' });
if (pub.links?.demo) linkItems.push({ label: 'Demo', href: pub.links.demo, icon: 'play' });

const hasEqualContribution = pub.authors.some((author) => author.includes('*'));
const hasCorresponding = pub.authors.some((author) => author.includes('†'));
const authorNotes = [
  hasEqualContribution ? '* Equal contribution' : '',
  hasCorresponding ? '† Corresponding author' : '',
].filter(Boolean);

const abstractId = `drawer-abstract-${pub.id}`;
const bibtexId = `drawer-bibtex-${pub.id}`;
const bibtexCodeId = `bibtex-${pub.id}`;
---

<article
  id={`pub-${pub.id}`}
  class="pub-item grid scroll-mt-28 grid-cols-1 gap-4 sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-6"
  data-pub-item
  data-selected={String(pub.selected)}
  data-tags={pub.tags.join('|')}
  data-year={String(pub.year)}
  hidden={!pub.selected}
>
  <button
    type="button"
    class="pub-teaser group relative block aspect-[16/10] w-full overflow-hidden rounded-md border border-slate-200/80 bg-slate-50 text-left shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-white/[0.03] dark:shadow-none"
    data-lightbox
    data-src={withBase(pub.teaser)}
    data-caption={pub.title}
    aria-label={`Enlarge teaser image for ${pub.title}`}
  >
    <img
      src={withBase(pub.teaser)}
      alt={`Teaser figure for ${pub.title}`}
      width="360"
      height="225"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    {
      pub.teaserHover && (
        <img
          src={withBase(pub.teaserHover)}
          alt=""
          aria-hidden="true"
          width="360"
          height="225"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
        />
      )
    }
    <span
      class="absolute right-2 top-2 inline-flex h-6 w-6 items-center justify-center rounded-md bg-slate-950/55 text-white opacity-0 backdrop-blur-sm transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
      aria-hidden="true"
    >
      <Icon name="expand" size={12} />
    </span>
  </button>

  <div class="min-w-0">
    <h3
      class="font-serif text-[17px] font-semibold leading-snug tracking-tight text-slate-900 dark:text-slate-100"
    >
      {
        pub.links?.pdf ? (
          <a
            href={pub.links.pdf}
            target={isExternal(pub.links.pdf) ? '_blank' : undefined}
            rel={isExternal(pub.links.pdf) ? 'noopener noreferrer' : undefined}
            class="transition-colors hover:text-blue-700 dark:hover:text-blue-300"
          >
            {pub.title}
          </a>
        ) : (
          pub.title
        )
      }
    </h3>

    <p class="mt-1.5 text-[13px] leading-6 text-slate-500 dark:text-slate-400">
      {
        pub.authors.map((author, index) => {
          const match = author.match(/^(.*?)([*†]+)$/);
          const name = (match ? match[1] : author).trim();
          const marks = match ? match[2] : '';
          const isSelf = name === profile.name;
          return (
            <>
              {index > 0 && ', '}
              <span class={isSelf ? 'font-semibold text-slate-900 dark:text-slate-100' : ''}>
                {name}
              </span>
              {marks && (
                <sup class="ml-px font-mono text-[9px] font-medium text-blue-600 dark:text-blue-400">
                  {marks}
                </sup>
              )}
            </>
          );
        })
      }
    </p>

    {
      authorNotes.length > 0 && (
        <p class="mt-1 text-[10px] text-slate-400 dark:text-slate-500">
          {authorNotes.join(' · ')}
        </p>
      )
    }

    <div class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
      <span class="text-[11.5px] font-semibold tracking-wide text-blue-700 dark:text-blue-300">
        {pub.venue}
      </span>
      {
        pub.highlight && (
          <span class="text-[11.5px] font-semibold text-amber-700 dark:text-amber-400">
            ({pub.highlight})
          </span>
        )
      }
    </div>

    <p class="mt-2 text-[13.5px] leading-6 text-slate-700 dark:text-slate-300">
      <span class="font-semibold text-slate-900 dark:text-slate-100">TL;DR</span>
      <span class="mx-1.5 text-slate-300 dark:text-slate-600">·</span>
      {pub.tldr}
    </p>

    <div class="pub-actions mt-3 flex flex-wrap items-center gap-1.5">
      {
        linkItems.map((link) => {
          const externalLink = isExternal(link.href);
          return (
            <a
              href={externalLink ? link.href : withBase(link.href)}
              target={externalLink ? '_blank' : undefined}
              rel={externalLink ? 'noopener noreferrer' : undefined}
              class="link-pill"
            >
              <Icon name={link.icon} size={12} />
              {link.label}
            </a>
          );
        })
      }
      <button
        type="button"
        class="link-pill"
        data-drawer-toggle="abstract"
        aria-expanded="false"
        aria-controls={abstractId}
      >
        <Icon name="abstract" size={12} />
        Abstract
      </button>
      <button
        type="button"
        class="link-pill"
        data-drawer-toggle="bibtex"
        aria-expanded="false"
        aria-controls={bibtexId}
      >
        <Icon name="braces" size={12} />
        BibTeX
      </button>
    </div>

    <div
      class="pub-drawer"
      data-drawer
      data-drawer-name="abstract"
      id={abstractId}
      data-open="false"
      inert
    >
      <div class="min-h-0 overflow-hidden">
        <div
          class="mt-3 rounded-md border border-slate-200/80 bg-slate-50/70 p-4 text-[13px] leading-6 text-slate-700 dark:border-slate-800 dark:bg-white/[0.02] dark:text-slate-300"
        >
          <p>
            <span class="font-semibold text-slate-900 dark:text-slate-100">Abstract.</span>{' '}
            {pub.abstract}
          </p>
        </div>
      </div>
    </div>

    <div
      class="pub-drawer"
      data-drawer
      data-drawer-name="bibtex"
      id={bibtexId}
      data-open="false"
      inert
    >
      <div class="min-h-0 overflow-hidden">
        <div
          class="mt-3 overflow-hidden rounded-md border border-slate-200/80 bg-slate-50 dark:border-slate-800 dark:bg-white/[0.02]"
        >
          <div
            class="flex items-center justify-between border-b border-slate-200/80 px-3 py-1.5 dark:border-slate-800"
          >
            <span
              class="font-mono text-[10px] uppercase tracking-[0.12em] text-slate-400 dark:text-slate-500"
            >
              BibTeX
            </span>
            <button
              type="button"
              class="copy-button inline-flex items-center gap-1.5 rounded-full px-2 py-1 text-[10.5px] font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
              data-copy-bibtex
              data-copy-target={bibtexCodeId}
            >
              <Icon name="copy" size={11} class="copy-icon" />
              <Icon name="check" size={11} class="copy-check hidden" />
              <span class="copy-label" aria-live="polite">Copy</span>
            </button>
          </div>
          <pre
            class="m-0 max-h-[45vh] overflow-auto whitespace-pre-wrap break-words p-3.5 font-mono text-[11px] leading-[1.65] text-slate-700 dark:text-slate-300"
          ><code id={bibtexCodeId}>{pub.bibtex}</code></pre>
        </div>
      </div>
    </div>
  </div>
</article>
